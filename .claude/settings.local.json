{
  "permissions": {
    "allow": [
      "Bash(lsof -ti:8000,3000)",
      "Bash(lsof -i:8000 -i:3000)",
      "Bash(xargs kill -9)",
      "Bash(npm run *)",
      "Bash(echo \"Frontend PID: $!\")",
      "Bash(curl -s -o /dev/null -w \"Backend \\(8000\\): %{http_code}\\\\n\" http://localhost:8000/docs)",
      "Bash(curl -s -o /dev/null -w \"Frontend \\(3000\\): %{http_code}\\\\n\" http://localhost:3000)"
    ]
  }
}
